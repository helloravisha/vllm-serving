# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Keep comments on their own lines: Docker treats text after "=" as the value.

# Clients and the gateway send this as the Bearer token.
VLLM_API_KEY=change-me

# Only needed for gated models (Llama, Gemma).
HF_TOKEN=

VLLM_IMAGE_TAG=v0.32.0
